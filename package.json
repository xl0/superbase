{
	"name": "@xl0/superbase",
	"version": "0.1.1",
	"description": "A local Postgres table and SQL editor inspired by Supabase Studio.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xl0/superbase.git"
	},
	"type": "module",
	"bin": {
		"superbase": "bin/superbase.js"
	},
	"files": [
		"bin",
		"build",
		"!build/**/*.map"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev --host 127.0.0.1",
		"start": "node --env-file-if-exists=.env bin/superbase.js --no-open",
		"test": "node --test tests/editor.test.ts && bun test tests/values.test.ts tests/json.test.ts tests/db.test.ts tests/schema.test.ts tests/export.test.ts tests/sql.test.ts",
		"test:production": "bun run build && node --test tests/server.test.mjs",
		"build": "vite build",
		"dev:demo": "vite dev --host 127.0.0.1 --mode demo",
		"build:demo": "vite build --mode demo",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"prepack": "bun run build",
		"verify": "bun run check && bun run test && bun run test:production",
		"release": "bun run scripts/release.ts"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"pg": "8.23.1"
	},
	"devDependencies": {
		"@codemirror/commands": "6.11.1",
		"@codemirror/lang-json": "6.0.2",
		"@codemirror/lang-sql": "6.10.0",
		"@codemirror/language": "6.13.1",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.15",
		"@dagrejs/dagre": "3.1.1",
		"@electric-sql/pglite": "0.5.10",
		"@fontsource-variable/inter": "5.3.0",
		"@internationalized/date": "3.12.4",
		"@lezer/highlight": "1.2.5",
		"@lucide/svelte": "1.61.0",
		"@sveltejs/adapter-node": "6.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/pg": "8.23.1",
		"@xyflow/svelte": "1.7.0",
		"bits-ui": "2.20.2",
		"cn": "0.5.0",
		"runed": "0.38.0",
		"shadcn-svelte": "1.7.0",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"vite": "8.3.5"
	}
}
